# .NET Specific
# Ignore Visual Studio files and directories
.vs/
.vscode/
.idea/

# Ignore user secrets
secrets.json
appsettings.Development.json
appsettings.Local.json

# Ignore build outputs
/bin/
/obj/
**/bin/
**/obj/

# Ignore dependency directories
/packages/

# Ignore published files (including Azure publish)
publish/

# Ignore Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Ignore temporary files generated by Visual Studio
*.user
*.userosscache
*.suo
*.sln.docstates

# Ignore ASP.NET Core's session storage files
.session/

# Ignore test results
TestResults/

# Ignore coverage and profiling
.coverage
*.profiler

# Angular Specific
# Ignore node_modules (this is huge, and should not be in Git)
node_modules/
**/node_modules/

# Ignore build artifacts
/dist/
/build/
/tmp/
/out-tsc/

# Ignore logs
*.log

# Ignore IDE files
.idea/
/.vscode/

# Ignore Angular configuration for sensitive info (if you store any secrets in these files)
src/app/config/*.secret.json
src/app/config/.env

# Ignore environment files (if secrets are stored here)
src/environments/environment.prod.ts
src/environments/environment.ts

# Ignore Angular cache
/.angular/

# Ignore TypeScript files
*.tsbuildinfo

# Ignore npm and yarn lock files if you're using a package manager that's not npm
# yarn.lock

# Ignore coverage and test files
coverage/
*.lcov

# Ignore temporary files
*.swp
*.swo

# Ignore IDE specific files
.idea/
.vscode/

# Ignore MacOS system files
.DS_Store

# Ignore Windows system files
Thumbs.db

# Ignore .cache files generated by Angular or other tools
.cache/
